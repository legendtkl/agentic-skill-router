#!/usr/bin/env sh
set -eu

PRG=$0
while [ -L "$PRG" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "$PRG")" && pwd)
  LINK=$(readlink "$PRG")
  case "$LINK" in
    /*) PRG=$LINK ;;
    *) PRG=$DIR/$LINK ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$PRG")" && pwd)
exec node "$SCRIPT_DIR/../lib/skill-router.mjs" "$@"
