{
  "name": "agentic-skill-router",
  "version": "0.1.5",
  "description": "Agentic Search-inspired non-vectorized routing and management for Agent Skills",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agentic-skill-router": "bin/agentic-skill-router"
  },
  "files": [
    "README.md",
    "assets/",
    "bin/",
    "lib/agentic-skill-router.mjs",
    "skills/",
    "plugins/claude-code/.claude-plugin/plugin.json",
    "plugins/codex/.codex-plugin/plugin.json",
    "plugins/codex/prompts/"
  ],
  "scripts": {
    "generate:assets": "node scripts/generate-assets.mjs",
    "check:assets": "node scripts/generate-assets.mjs --check",
    "check:pack": "node scripts/check-pack.mjs",
    "build": "node scripts/generate-assets.mjs && node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "test:e2e": "npm run test:e2e:network",
    "test:e2e:offline": "node --test --test-concurrency=1 --import tsx tests/cli-offline.e2e.ts",
    "test:e2e:network": "node --test --test-concurrency=1 --import tsx --test-name-pattern=agentic-skill-router-cli tests/codex-openai.e2e.ts tests/claude-openai.e2e.ts",
    "test:e2e:agent": "node --test --test-concurrency=1 --import tsx --test-name-pattern=\"(codex-cli|claude-cli)\" tests/codex-openai.e2e.ts tests/claude-openai.e2e.ts",
    "test:e2e:codex": "node --test --import tsx --test-name-pattern=\"codex-cli\" tests/codex-openai.e2e.ts",
    "test:e2e:claude": "node --test --import tsx --test-name-pattern=\"claude-cli\" tests/claude-openai.e2e.ts",
    "eval:route": "node --import tsx scripts/eval-route.mjs",
    "cli": "tsx src/cli.ts",
    "install:plugin": "node scripts/install.mjs",
    "uninstall:plugin": "node scripts/uninstall.mjs",
    "install:codex-plugin": "node scripts/install-codex.mjs",
    "uninstall:codex-plugin": "node scripts/uninstall-codex.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
