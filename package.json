{
  "name": "skill-router",
  "version": "0.1.0",
  "description": "Manage installed Claude Code and Codex skills based on usage",
  "type": "module",
  "private": true,
  "bin": {
    "skill-router": "./plugins/codex/bin/skill-router"
  },
  "files": [
    "README.md",
    "plugins/claude-code/.claude-plugin/plugin.json",
    "plugins/claude-code/bin/",
    "plugins/claude-code/lib/",
    "plugins/claude-code/skills/",
    "plugins/codex/.codex-plugin/plugin.json",
    "plugins/codex/bin/",
    "plugins/codex/lib/",
    "plugins/codex/prompts/",
    "plugins/codex/skills/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "cli": "tsx src/cli.ts",
    "install:plugin": "node scripts/install.mjs",
    "uninstall:plugin": "node scripts/uninstall.mjs",
    "install:codex-plugin": "node scripts/install-codex.mjs",
    "uninstall:codex-plugin": "node scripts/uninstall-codex.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
